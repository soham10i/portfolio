# Dependencies
node_modules/
app/node_modules/
backend/node_modules/

# Build output
app/dist/
dist/

# Temp & backups
_to_delete/
.DS_Store

# Logs
*.log
npm-debug.log*

# OS metadata
Thumbs.db

# Uncompressed source recordings — nothing serves these, and they are 49 MB.
# The compressed clips in app/public/videos/*.mp4 ARE tracked and must ship.
app/public/videos/_orig/

# Local .env backups made when rotating tokens
backend/.env.bak.*
backend/.env.gemini.bak

# ── Private project working files ────────────────────────────────────────────
# Source material for the projects the portfolio *describes* lives here: CAD,
# simulation scenes, extracted control logic, measurement sheets. The public
# site links to write-ups and videos, never to this. Nothing in projects/ is
# served — Express serves app/dist only — and it is untracked so a public
# GitHub remote cannot expose it either.
#
# The cost of that choice: no version history. If this material becomes worth
# versioning, the right fix is a separate PRIVATE repository (or a private
# submodule), not un-ignoring this folder.
projects/

# ── Secrets ──────────────────────────────────────────────────────────────────
# Every real value lives in the host's environment (the Render dashboard) or in
# an untracked local .env. Only the *.example templates are ever committed.
.env
.env.*
!.env.example
!*/.env.example

# ── Python (scene-api) ───────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
scene-api/.venv/

# ── Archives ─────────────────────────────────────────────────────────────────
# Source drops land here by hand; they are inputs, not deliverables, and a
# tracked 11 MB tarball is paid for by every clone and every Render build.
*.tgz
*.tar.gz
*.zip

# ── Editor / agent state ─────────────────────────────────────────────────────
.claude/
.idea/
.vscode/
