# Cloud Build upload context. Extends .gitignore with what Docker never needs.
# Every directory rule is anchored to the repo root — an unanchored `projects/`
# also matches app/src/features/projects/ and silently drops source files
# (learned the hard way: the first build failed on exactly that).
.git/
.gcloudignore
node_modules/
app/node_modules/
backend/node_modules/
app/dist/
dist/
.env
.env.*
*.log
.DS_Store
/.tmp/
/_to_delete/
# Local working areas the image never reads (see .gitignore for why).
/projects/
/cv/
/docs/
/supabase/
app/public/videos/_orig/
