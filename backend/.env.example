# Backend Environment Configuration
# Copy this file to .env and fill in your values.
# DO NOT commit .env to git — it contains secrets.

# ── Server ──
PORT=3001
NODE_ENV=development

# ── Language Model (OpenAI-compatible endpoint) ──
# Examples:
#   OpenRouter (recommended): https://openrouter.ai/api/v1
#   Groq (fastest):          https://api.groq.com/openai/v1
#   Ollama local:            http://127.0.0.1:11434/v1
#   vLLM self-hosted:        https://your-vllm.com/v1
# Leave empty to run without LLM (chat returns 503, detection still works).
LLM_API_BASE=https://openrouter.ai/api/v1

# Recommended models:
#   Free tier: meta-llama/llama-3.1-8b-instruct
#   Better:    qwen/qwen-2.5-14b-instruct
LLM_MODEL=meta-llama/llama-3.1-8b-instruct
LLM_VISION_MODEL=meta-llama/llama-3.2-11b-vision-instruct

# Get your key at https://openrouter.ai/keys
LLM_API_KEY=
# Examples:
#   Ollama local:      http://127.0.0.1:11434/v1
#   vLLM self-hosted:  https://your-vllm.com/v1
#   OpenRouter:        https://openrouter.ai/api/v1
#   Groq:              https://api.groq.com/openai/v1
# Leave empty to run without LLM (chat returns 503, detection still works).
LLM_API_BASE=http://127.0.0.1:11434/v1
LLM_MODEL=qwen2.5:7b-instruct
LLM_VISION_MODEL=qwen2.5vl:7b
LLM_API_KEY=

# ── SceneLab BLIP Service (optional) ──
# Set after deploying scene-api separately.
# Example: https://scene-api-yourname.onrender.com
SCENE_API_BASE=

# ── Notes Editing ──
# Generate: openssl rand -base64 32
# Leave empty to make notes read-only.
ADMIN_TOKEN=

# ── CORS ──
# Comma-separated origins allowed to call the API from a browser.
# In production (single-service deploy) leave unset for same-origin only.
# ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001
