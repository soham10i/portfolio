# ─────────────────────────────────────────────────────────────────────────────
# Backend configuration.  Copy to .env and fill in the three keys.
# .env is gitignored; only this template is committed.
#
# The site runs with NOTHING set here — chat answers 503 and every other route
# works. A missing key must never take the portfolio down.
#
# Every model id below was called for real on 2026-08-30 and answered 200 with
# non-empty content. Re-verify before changing one: scripts/probe-providers.sh
# ─────────────────────────────────────────────────────────────────────────────

PORT=3001
# NODE_ENV=production


# ── Chat: Gemini ─────────────────────────────────────────────────────────────
# LLM_PROVIDER selects an entry from backend/src/config/providers.js, which
# supplies the base URL and a default model id. Only the key is a secret.
#
# gemini-3.5-flash-lite — 815ms.  Use the rolling alias gemini-flash-lite-latest
# (613ms) instead if you would rather not chase id changes.
#
# Do NOT use: gemini-2.5-flash-lite (404, retired), gemini-2.0-flash-lite (404),
# gemini-2.5-flash (16.4s, returns empty content at small max_tokens).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=                    # AIza...    https://aistudio.google.com/app/apikey


# ── Vision: NVIDIA NIM ───────────────────────────────────────────────────────
# SceneLab keyframe captioning. Resolved independently of text because the free
# tiers are not good at the same things.
#
# llama-3.2-11b-vision-instruct — 1463ms on a 19KB JPEG, accurate caption.
# The 90B sibling TIMED OUT at 90s. Groq serves no vision model at all.
LLM_VISION_PROVIDER=nvidia
LLM_VISION_MODEL=meta/llama-3.2-11b-vision-instruct
NVIDIA_API_KEY=                    # nvapi-...  https://build.nvidia.com


# ── Fallback: Groq ───────────────────────────────────────────────────────────
# Tried once when the primary answers 429 or 5xx. Must be a DIFFERENT vendor —
# that is its entire job. gpt-oss-120b: 611ms, 131k context.
#
# Groq's catalogue is small and volatile. llama-3.3-70b-versatile is GONE.
# Currently serving: openai/gpt-oss-120b, openai/gpt-oss-20b (219ms),
# qwen/qwen3.8-27b (285ms), qwen/qwen3.6-27b, groq/compound.
LLM_FALLBACK_PROVIDER=groq
LLM_FALLBACK_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=                      # gsk_...    https://console.groq.com/keys


# ── Larger models, when you want them ────────────────────────────────────────
# NVIDIA also serves genuinely large models free. Verified:
#   nvidia/nemotron-3-ultra-550b-a55b   5850ms   (550B total / 55B active MoE)
#   nvidia/nemotron-3-super-120b-a12b   2321ms
#
# Too slow for interactive chat, fine for one-shot reasoning. Point MedQA or
# SceneLab summarisation at it by using the `nvidia-large` preset:
#   LLM_PROVIDER=nvidia-large
#
# Not every listed id is provisioned per account — nemotron-4-340b,
# llama-3.1-nemotron-ultra-253b and llama-3.1-nemotron-70b all answer 404.


# ── Qwen ─────────────────────────────────────────────────────────────────────
# Qwen TEXT is free on Groq:  LLM_FALLBACK_MODEL=qwen/qwen3.8-27b  (285ms)
#
# Qwen VISION is not free anywhere you have an account. OpenRouter lists 26
# vision-capable Qwen models and none of them are :free. If you fund the
# account, qwen/qwen3-vl-8b-instruct is $0.117/M input — roughly $0.14 per
# thousand keyframe captions:
#   LLM_VISION_PROVIDER=openrouter
#   LLM_VISION_MODEL=qwen/qwen3-vl-8b-instruct
#   OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_API_KEY=


# ── Overrides ────────────────────────────────────────────────────────────────
# Any explicit value wins over the provider preset — point at a self-hosted
# vLLM, an Ollama on your desk, an HF Inference Endpoint.
# LLM_API_BASE=http://127.0.0.1:11434/v1
# LLM_API_KEY=
# LLM_TIMEOUT_MS=120000


# ── MedQA ────────────────────────────────────────────────────────────────────
# The retrieval index loads a quantised embedding model, the largest allocation
# in this process. Set false to keep the rest of the site alive on a 512 MB host.
# MEDQA_ENABLED=false


# ── SceneLab BLIP service (optional) ─────────────────────────────────────────
# Only if you host scene-api on a GPU box. Its image is nvidia/cuda + torch +
# weights, several GB — it does not fit Render's free plan and there is no GPU
# there. Unset means SceneLab captions with the vision model above; in-browser
# detection is unaffected either way.
# SCENE_API_BASE=https://your-scene-api.example.com


# ── Notes ────────────────────────────────────────────────────────────────────
# A long random string. Without it the notes section is read-only, which is the
# correct default for a public deployment.
# ADMIN_TOKEN=


# ── CORS ─────────────────────────────────────────────────────────────────────
# In production this process serves the built frontend, so page and API share an
# origin and no CORS is needed. Unset in production means same-origin only.
# ALLOWED_ORIGINS=https://example.com
