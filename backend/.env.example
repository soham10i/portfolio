# ─────────────────────────────────────────────────────────────────────────────
# Backend configuration.  Copy to .env and fill in one key.
# .env is gitignored; only this template is ever committed.
#
# The site runs with NOTHING set here — chat answers 503 and everything else
# works. Configure a provider to switch the assistant on.
# ─────────────────────────────────────────────────────────────────────────────

PORT=3001
# NODE_ENV=production


# ── Language model ───────────────────────────────────────────────────────────
# Two variables is the whole setup. LLM_PROVIDER selects an entry from
# backend/src/config/providers.js, which supplies the base URL and a model id.
#
#   groq | openrouter | nvidia | gemini | ollama
#
# DEFAULT: Groq. Fastest free inference available, which is what an interactive
# chat widget is judged on, and its free tier is token-metered per day rather
# than capped at a few dozen requests.
LLM_PROVIDER=groq
GROQ_API_KEY=                      # gsk_...   https://console.groq.com/keys

# ── Fallback (strongly recommended) ──
# Tried once when the primary answers 429 or 5xx. Free tiers rate-limit hard,
# and the point of a fallback is that it is a DIFFERENT vendor — pointing it at
# the same one buys nothing. openrouter/free is an auto-router across a pool of
# free models, so it survives any single model being retired.
LLM_FALLBACK_PROVIDER=openrouter
OPENROUTER_API_KEY=                # sk-or-... https://openrouter.ai/keys

# ── Vision (SceneLab keyframe captioning) ──
# Vision and text are resolved separately because the free tiers are not good
# at the same things: as of Aug 2026 NVIDIA's free text models are EOL or 404
# while its vision models still answer. Omit this block and vision falls back
# to whatever the text provider is.
LLM_VISION_PROVIDER=nvidia
NVIDIA_API_KEY=                    # nvapi-... https://build.nvidia.com

# ── Overrides ──
# Any explicit value wins over the provider preset. Use these to pin a specific
# model, or to point at something the registry has never heard of — a vLLM you
# host, an Ollama on your desk, an HF Inference Endpoint.
# LLM_API_BASE=http://127.0.0.1:11434/v1
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=
# LLM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
# LLM_TIMEOUT_MS=120000
#
# Free-tier model ids are retired without notice. Before trusting one:
#   scripts/probe-providers.sh
#   scripts/probe-providers.sh models groq


# ── MedQA demo ───────────────────────────────────────────────────────────────
# The retrieval index loads a quantised embedding model — the largest single
# allocation in this process. On a 512 MB instance that is tight. Set false to
# keep the rest of the site healthy on a constrained host.
# MEDQA_ENABLED=false


# ── SceneLab BLIP service (optional) ─────────────────────────────────────────
# The project's own FastAPI + BLIP service, when it is hosted. Unset means
# SceneLab captions with the vision model instead; detection is unaffected
# either way because it runs in the visitor's browser.
# SCENE_API_BASE=https://your-scene-api.example.com
# SCENE_TIMEOUT_MS=120000


# ── Notes ────────────────────────────────────────────────────────────────────
# A long random string. Without it the notes section is read-only, which is the
# correct default for a public deployment.
# ADMIN_TOKEN=


# ── CORS (optional) ──────────────────────────────────────────────────────────
# In production this process serves the built frontend, so the page and the API
# share an origin and no CORS is needed. Set this only if the API is called from
# somewhere else. Unset in production means same-origin only.
# ALLOWED_ORIGINS=https://example.com
