# Backend Environment Configuration
# Copy this file to .env and fill in your values.
# DO NOT commit .env to git — it contains secrets.

# ── Server ──
PORT=3001
# NODE_ENV=production

# ── Language Model (OpenAI-compatible endpoint) ──
# JARVIS talks to any /chat/completions API — pick a provider below and fill
# in the matching key. Leave LLM_API_BASE empty to run without LLM (chat
# returns 503, the rest of the site still works).
#
# DEFAULT (OpenRouter) — free tier includes 70B models, best for MedQA.
# Get key: https://openrouter.ai/keys
LLM_API_BASE=https://openrouter.ai/api/v1
LLM_MODEL=meta-llama/llama-3.1-70b-instruct
LLM_API_KEY=

# Vision can be on a different provider than text (e.g. NVIDIA NIM for vision,
# OpenRouter for text). When LLM_VISION_API_BASE is omitted it falls back to
# LLM_API_BASE (same provider for both).
#
# NVIDIA NIM — vision models still work on free tier as of Aug 2026.
# Key: https://build.nvidia.com
LLM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
# LLM_VISION_API_BASE=https://integrate.api.nvidia.com/v1
# LLM_VISION_API_KEY=nvapi-...

# ── Free-tier provider profiles (2026) ──
#
# Google AI Studio — most generous free tier (~10–15 RPM, 500–1500 req/day).
# Key: https://aistudio.google.com/app/apikey
#   LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-2.5-flash        # or gemini-2.0-flash-lite for max quota
#   LLM_API_KEY=AIza...
#
# NVIDIA NIM — dev program tier (~40 RPM), 100+ hosted models.
#   NOTE: As of Aug 2026, text models (8B, 70B) are EOL or 404 on free tier.
#   Vision models (11B, 90B) still work. Use only for LLM_VISION_* vars.
# Key: https://build.nvidia.com
#   LLM_VISION_API_BASE=https://integrate.api.nvidia.com/v1
#   LLM_VISION_MODEL=meta/llama-3.2-90b-vision-instruct
#   LLM_VISION_API_KEY=nvapi-...
#
# OpenRouter — rotating :free model pool (20 RPM, 50 req/day; raised to
# 1000/day after a one-time $10 credit purchase). "openrouter/free" is an
# auto-router that picks an available free model for you.
# Key: https://openrouter.ai/keys
#   LLM_API_BASE=https://openrouter.ai/api/v1
#   LLM_MODEL=openrouter/free
#   LLM_API_KEY=sk-or-...
#
# Groq — fastest inference, free tier: 1M tokens/day.
# Key: https://console.groq.com/keys
#   LLM_API_BASE=https://api.groq.com/openai/v1
#   LLM_MODEL=llama-3.1-70b-versatile
#   LLM_API_KEY=gsk-...
#
# Other: Ollama local (http://127.0.0.1:11434/v1), vLLM self-hosted.

# ── Automatic fallback (optional, recommended for free tiers) ──
# When the primary provider answers 429 or 5xx, the request is retried once
# against this second provider. Point it at a DIFFERENT vendor than the
# primary so one vendor's quota wall doesn't take JARVIS down.
# LLM_FALLBACK_API_BASE=https://openrouter.ai/api/v1
# LLM_FALLBACK_MODEL=openrouter/free
# LLM_FALLBACK_API_KEY=sk-or-...

# ── Scene captioning service (optional) ──
# SCENE_API_BASE=

# ── Notes admin (optional) ──
# ADMIN_TOKEN=

# ── CORS (optional; comma-separated origins) ──
# In production the frontend is served by this same process, so no CORS is
# needed. Set only if the API is called from another origin.
# ALLOWED_ORIGINS=https://example.com
