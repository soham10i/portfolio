# Base URL the chat panel and contact form post to.
# Leave as /api in development: vite.config.ts proxies /api to the Express
# backend on :3001, so no CORS and no hard-coded host.
# In production the backend serves app/dist from the same origin, so /api
# still works. Set an absolute URL only when the API lives elsewhere,
# e.g. VITE_CHAT_API_BASE=https://api.example.com/api
VITE_CHAT_API_BASE=/api

# Base URL of the Real-Time-Scene-Understanding FastAPI service, used by the
# /scene demo for keyframe captions. Leave unset and the demo still runs
# detection locally, showing the captioning service as offline.
# Set this on the BACKEND process, not here — it is server-side only:
#   SCENE_API_BASE=https://your-scene-service.example.com

# Smart Tabletop Factory twin on Google Cloud Run (build-time, VITE_*).
# VITE_STF_URL defaults to the live deployment; set it empty to hide the links.
# VITE_STF_EMBED=true shows the twin inside the Lab section. Only enable it
# after the STF service allows this site in frame-ancestors
# (docs/stf-allow-embed.patch), or the frame shows "refused to connect".
# VITE_STF_URL=https://stf-live-500754517962.europe-west1.run.app/stf/
VITE_STF_EMBED=false
