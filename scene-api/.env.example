# Scene API Environment Configuration
# Copy this file to .env and fill in your values.

# ── Server ──
HOST=0.0.0.0
PORT=8000

# ── Model ──
# HuggingFace model ID for image captioning.
# Options:
#   Salesforce/blip-image-captioning-base   (default, ~2GB VRAM)
#   Salesforce/blip-image-captioning-large  (better quality, ~3.5GB VRAM)
#   microsoft/git-base-coco                 (alternative, ~1.5GB VRAM)
MODEL_NAME=Salesforce/blip-image-captioning-base

# ── Hardware ──
# Set to 'cpu' for CPU inference (slower, no GPU needed).
# Set to 'cuda' for GPU inference (requires NVIDIA GPU + drivers).
DEVICE=cuda

# ── Limits ──
# Maximum upload size in bytes (default: 15 MB).
MAX_IMAGE_BYTES=15728640

# ── Logging ──
LOG_LEVEL=info
