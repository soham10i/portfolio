NEXUS_DB_URL=postgresql://nexus:nexus@localhost:5433/nexus

# Signed checkpoints of every stream head (ADR-0019), so `nexus chain verify` catches a full
# rewrite of the history. Keep the key and the anchor directory away from the database's owners.
# Make a key with: python -c "import secrets; print('k1:' + secrets.token_hex(32))"
NEXUS_ANCHOR_KEYS=
NEXUS_ANCHOR_DIR=

# Model providers (P5). Free tiers only; leave a key empty and that provider is skipped.
# Gemini's free tier may use what it receives to improve Google's products: send no private data.
GEMINI_API_KEY=
GROQ_API_KEY=
