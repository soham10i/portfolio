{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nexus.local/contracts/v1/evidence-pack.schema.json",
  "title": "Evidence pack",
  "description": "Everything needed to explain one action after the fact: the proposal, the decision, every check, the simulation, approvals, execution, verification, and pointers into the event chain.",
  "type": "object",
  "additionalProperties": false,
  "required": ["proposal", "decision", "checks", "approvals", "execution", "verification", "event_refs", "chain_head"],
  "properties": {
    "proposal": {"$ref": "proposal.schema.json"},
    "decision": {"$ref": "decision.schema.json"},
    "checks": {
      "description": "Each check the gate ran, in order.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed"],
        "properties": {
          "name": {"type": "string", "minLength": 1, "maxLength": 128},
          "passed": {"type": "boolean"},
          "detail": {"type": "string", "maxLength": 2000}
        }
      }
    },
    "simulation": {
      "description": "Sandbox run, if the action declares one.",
      "type": "object",
      "additionalProperties": false,
      "required": ["ran"],
      "properties": {
        "ran": {"type": "boolean"},
        "sandbox": {"$ref": "common.schema.json#/$defs/id_segment"},
        "passed": {"type": "boolean"},
        "summary": {"type": "string", "maxLength": 4000},
        "trace_ref": {"type": "string", "maxLength": 512}
      }
    },
    "approvals": {
      "description": "Approvals that count; each binds the exact proposal hash, and a signed one carries its signature.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["approver", "proposal_hash", "approved_at"],
        "properties": {
          "approver": {"$ref": "common.schema.json#/$defs/actor"},
          "proposal_hash": {"$ref": "common.schema.json#/$defs/sha256_hex"},
          "approved_at": {"$ref": "common.schema.json#/$defs/timestamp"},
          "signature": {
            "description": "Ed25519 over JCS({v: \"nexus.approval/1\", decision_id, proposal_hash, approver: {kind, id}}), hex encoded (ADR-0027). Present only on a signed approval; verified says it verified when the pack was built.",
            "type": "object",
            "additionalProperties": false,
            "required": ["alg", "key_id", "public_key", "value", "verified"],
            "properties": {
              "alg": {"const": "ed25519"},
              "key_id": {"type": "string", "pattern": "^[0-9a-f]{32}$"},
              "public_key": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "value": {"type": "string", "pattern": "^[0-9a-f]{128}$"},
              "verified": {"type": "boolean"}
            }
          }
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["not_run", "succeeded", "failed", "compensated"]},
        "idempotency_key": {"type": "string", "minLength": 8, "maxLength": 128},
        "started_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "finished_at": {"$ref": "common.schema.json#/$defs/timestamp"},
        "error": {"$ref": "common.schema.json#/$defs/reason"}
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["not_run", "passed", "failed", "timed_out"]},
        "observed": {"description": "Observed values used to verify effects.", "type": "object"}
      }
    },
    "incidents": {
      "description": "Incidents opened while executing or compensating this action, in order. The evidence builder always fills it; [] means none.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["incident_id", "kind", "detail", "opened_at"],
        "properties": {
          "incident_id": {"$ref": "common.schema.json#/$defs/uuid"},
          "kind": {"$ref": "common.schema.json#/$defs/id_segment"},
          "detail": {"type": "string", "maxLength": 2000},
          "opened_at": {"$ref": "common.schema.json#/$defs/timestamp"}
        }
      }
    },
    "shadow": {
      "description": "Shadow mode: whether the executor ran in shadow (decided and recorded, nothing executed), and any human verdicts recorded next to the gate's. The evidence builder always fills it.",
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "comparisons"],
      "properties": {
        "active": {"type": "boolean"},
        "comparisons": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["human", "human_outcome", "agree", "recorded_at"],
            "properties": {
              "human": {"$ref": "common.schema.json#/$defs/actor"},
              "human_outcome": {"enum": ["ALLOW", "DENY", "NEEDS_APPROVAL"]},
              "agree": {"type": "boolean"},
              "recorded_at": {"$ref": "common.schema.json#/$defs/timestamp"}
            }
          }
        }
      }
    },
    "event_refs": {
      "description": "Events that record this action.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stream", "seq"],
        "properties": {
          "stream": {"type": "string", "minLength": 1, "maxLength": 256},
          "seq": {"type": "integer", "minimum": 1}
        }
      }
    },
    "chain_head": {"description": "Hash of the last event of this action's stream when the pack was built.", "$ref": "common.schema.json#/$defs/sha256_hex"}
  }
}
